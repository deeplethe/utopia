# 复制为 .env 后按需修改。所有配置走 UTOPIA_ 前缀的环境变量。
UTOPIA_DATABASE_URL=postgres://utopia:utopia@localhost:5432/utopia
UTOPIA_BIND_ADDR=0.0.0.0:8080
# 生产环境必须改成随机长密钥
UTOPIA_JWT_SECRET=dev-secret-change-me
# 前端构建产物目录（存在则由服务端托管 SPA）
UTOPIA_WEB_DIST=web/dist
# 数据目录：原始文件（files/）与全文索引（index/）
UTOPIA_DATA_DIR=data
# 开放注册；false 时仅首个用户可注册，其余由管理员开放
UTOPIA_OPEN_REGISTRATION=true
