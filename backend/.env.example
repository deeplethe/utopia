# OntoPilot backend configuration. Copy to `backend/.env` and fill in.
# Every value has a safe default in app/config.py except the OpenRouter key.

# PostgreSQL is used by Docker Compose. Leave empty for local SQLite development.
# DATABASE_URL=postgresql+psycopg://ontopilot:ontopilot@postgres:5432/ontopilot

# --- System language ---------------------------------------------------------
# Built-in model prompt language: en | zh-CN. Independent from the frontend locale.
# Docker Compose reads this setting from the root .env file; local runs read this file.
SYSTEM_LANGUAGE=en

# --- LLM / OpenRouter (required) ---------------------------------------------
# Get a key at https://openrouter.ai/. OntoPilot uses cheap models by default.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_EXTRACT_MODEL=deepseek/deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
# Semantic near-duplicate detection embedding model (also via OpenRouter — no local model download).
EMBEDDING_MODEL=baai/bge-m3

# --- Auth --------------------------------------------------------------------
# A single admin account is seeded on first boot when the user table is empty.
# CHANGE THESE before exposing the app. admin/admin is for local dev only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: seed a deterministic, no-LLM demo knowledge system into an empty installation.
SEED_DEMO_DATA=false
# Set true when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# --- CORS (frontend origins allowed to call the API) -------------------------
# JSON list. Add your deployed frontend origin here for production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Extraction tuning (optional; sensible defaults in app/config.py) ---------
# CHUNK_SIZE_TOKENS=900           # Docling structure-aware chunk budget
# EXTRACTION_MODE=auto            # auto | rag | agentic
# EXTRACTION_CONCURRENCY=10       # fallback/upgrade default; each model endpoint has its own limit
# ROLE_AUTO_ACCEPT_FLOOR=0.85     # independent role critic: accept automatically
# ROLE_REVIEW_FLOOR=0.55          # lower-confidence individuals enter human review
# TERMINOLOGY_SUGGESTION_MAX_CHUNKS=12
# TERMINOLOGY_SUGGESTION_MAX_CHARS=18000
# AUTOMATIC_TERMINOLOGY=true
# TERMINOLOGY_SUGGEST_DURING_EXTRACTION=true

# --- External read-only API -----------------------------------------------
# EXTERNAL_QUERY_MAX_ROWS=500      # hard ceiling for SPARQL SELECT rows
# EXTERNAL_QUERY_MAX_CHARS=20000   # reject oversized SPARQL queries
# Optional Fernet key for revealable API-token secrets. If omitted, OntoPilot creates
# data/token-encryption.key automatically. Back up whichever key source you use.
# TOKEN_ENCRYPTION_KEY=

# --- MCP --------------------------------------------------------------------
# Public Streamable HTTP endpoint advertised to MCP clients.
MCP_PUBLIC_URL=http://localhost:8000/mcp
# Default and maximum lifetime for user-delegated MCP tokens.
MCP_TOKEN_TTL_MINUTES=60
MCP_MAX_TOKEN_TTL_MINUTES=43200

# --- Direct RDF import -------------------------------------------------------
# RDF_IMPORT_MAX_BYTES=26214400     # 25 MiB upload limit
# RDF_IMPORT_MAX_TRIPLES=250000     # parsed statement ceiling
